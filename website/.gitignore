# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder template is documentation and must be committed.
!.env.example

# local CMS database (PGlite / Postgres-in-WASM) — see src/db/cms.ts
/.pglite/
# throwaway PGlite databases (cms:selftest, CMS_PGLITE_DIR experiments)
/.pglite-selftest/
/.pglite-*/

# test output
/test-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
