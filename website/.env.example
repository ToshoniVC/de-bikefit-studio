# ---------------------------------------------------------------------------
# Copy to .env.local and fill in what you need. The app boots with NONE of
# these set: the webshop falls back to sample products, Clerk/Stripe UI
# stays hidden, and the CMS runs on a local PGlite database.
#
# PLACEHOLDERS ONLY — never put a real secret in this file, it is committed.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Pooled connection string for the matching Neon branch.
# UNSET locally => the CMS uses PGlite in website/.pglite/ (gitignored) and the
# webshop serves src/lib/sample-products.ts. REQUIRED in production.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- CMS / Bikefit Studio --------------------------------------------------
# Pepper for hashing session tokens. REQUIRED in production; rotating it signs
# every CMS user out. Generate with: openssl rand -base64 48
CMS_SESSION_SECRET="replace-with-openssl-rand-base64-48"

# Password for the first admin (contact@toshoni.be) created by
# `npm run cms:bootstrap`. Pass it inline for that one command:
#   CMS_BOOTSTRAP_PASSWORD='…' npm run cms:bootstrap
# Do NOT store it in .env.local or in Vercel.
CMS_BOOTSTRAP_PASSWORD=""

# Canonical origin of the public site (canonical URLs, sitemap, OG images).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4 measurement id (G-XXXXXXXXXX), read on the server. GA4
# loads only when this is set AND "Analytics ingeschakeld" is on in /admin,
# and then only after the visitor accepts the cookie banner. Empty = no banner,
# no analytics script, no analytics cookie. See docs/booking-runbook.md §5.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# --- Booking: Google Calendar (optional) -----------------------------------
# OAuth client (type "Web application") from the Google Cloud console. Without
# these, providers cannot connect a calendar and availability uses business
# hours + existing bookings only. Redirect URI to register:
#   <NEXT_PUBLIC_SITE_URL>/api/google/oauth/callback
# See docs/booking-runbook.md.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Encrypts providers' Google refresh tokens (AES-256-GCM). base64 of 32 random
# bytes: openssl rand -base64 32
# Empty => a key is derived from CMS_SESSION_SECRET (HKDF-SHA256).
# Rotating EITHER value signs every provider out of Google (they reconnect).
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# --- Analytics dashboard: GA4 Data API (optional) --------------------------
# Numeric property id (NOT the G-XXXX measurement id). Overrides the
# analytics.ga4PropertyId site setting when set.
GA4_PROPERTY_ID=""
# Service-account key JSON (raw or base64). Give the service account the
# Viewer role on the GA4 property.
GA4_SERVICE_ACCOUNT_JSON=""

# --- Transactional e-mail via Resend (optional) ----------------------------
# Without RESEND_API_KEY, booking e-mails are logged to the console and skipped.
RESEND_API_KEY=""
# Sender on a domain verified in Resend, e.g.
#   De Bikefit Studio <afspraken@debikefitstudio.be>
EMAIL_FROM=""
# Optional Reply-To for customer mails.
EMAIL_REPLY_TO=""

# Optional: override where the local PGlite database is stored, and skip its
# automatic migration on first use.
# CMS_PGLITE_DIR=".pglite"
# CMS_PGLITE_AUTO_MIGRATE="false"

# --- Auth (Clerk) — webshop customers only ---------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_WEBHOOK_SECRET="whsec_xxx"

# --- Payments (Stripe) -----------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Set by Vercel — never set these by hand --------------------------------
# VERCEL_ENV    production | preview | development; `vercel dev` may use PGlite.
# VERCEL_URL    deployment host name; the last fallback for the site origin.

# --- Scripts only (never read by the app, never in Vercel) ------------------
# Pass inline for the one command that needs them.
# NEON_PROJECT_ID=""        # scripts/reset-staging.sh: Neon project to branch
# STAGING_DATABASE_URL=""   # scripts/reset-staging.sh + anonymize-staging.sql target
# PROVIDER_EMAIL=""         # npm run cms:seed-booking: first provider's login e-mail
# PROVIDER_NAME=""          # npm run cms:seed-booking: first provider's display name
