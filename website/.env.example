# Copy to .env.local and fill in. The app runs on sample data without most of
# these; add them to connect the database, gate, payments and email.

# --- Database: Neon (Postgres) ---
# Pooled connection string. Locally + the db:* scripts use DATABASE_URL.
# Point it at whichever branch you develop against (staging during the dev phase).
DATABASE_URL=

# --- Site access gate / "firewall" (staging) ---
# When SITE_GATE_PASSWORD is set, the whole site is locked behind Basic Auth.
# Set these on the Vercel *Staging* environment; leave them unset on Production.
SITE_GATE_USER=
SITE_GATE_PASSWORD=

# --- Auth (Phase 2: Auth.js email magic links) ---
# Generate AUTH_SECRET with: npx auth secret   (or openssl rand -base64 33)
AUTH_SECRET=
AUTH_RESEND_KEY=
EMAIL_FROM=

# --- Payments (Phase 2: Stripe) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
# Public base URL. e.g. http://localhost:3000 (local) or your prod/staging URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
