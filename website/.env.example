# ---------------------------------------------------------------------------
# Copy to .env.local and fill in what you need. The app boots with NONE of
# these set: the webshop falls back to sample products, Clerk/Stripe/Mollie UI
# stays hidden, and the CMS runs on a local PGlite database.
#
# PLACEHOLDERS ONLY — never put a real secret in this file, it is committed.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Pooled connection string for the matching Neon branch.
# UNSET locally => the CMS uses PGlite in website/.pglite/ (gitignored) and the
# webshop serves src/lib/sample-products.ts. REQUIRED in production.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- CMS / Bikefit Studio --------------------------------------------------
# Pepper for hashing session tokens. REQUIRED in production; rotating it signs
# every CMS user out. Generate with: openssl rand -base64 48
CMS_SESSION_SECRET="replace-with-openssl-rand-base64-48"

# Password for the first admin (contact@toshoni.be) created by
# `npm run cms:bootstrap`. Pass it inline for that one command:
#   CMS_BOOTSTRAP_PASSWORD='…' npm run cms:bootstrap
# Do NOT store it in .env.local or in Vercel.
CMS_BOOTSTRAP_PASSWORD=""

# Canonical origin of the public site (canonical URLs, sitemap, OG images).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4 — READINESS ONLY.
# Nothing in the app reads this. No analytics script and no analytics cookie
# ships until it is deliberately wired up. Leave empty.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Optional: override where the local PGlite database is stored, and skip its
# automatic migration on first use.
# CMS_PGLITE_DIR=".pglite"
# CMS_PGLITE_AUTO_MIGRATE="false"

# --- Auth (Clerk) — webshop customers only ---------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_WEBHOOK_SECRET="whsec_xxx"

# --- Payments (Stripe) -----------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# --- Payments (Mollie — Bancontact / iDEAL) --------------------------------
MOLLIE_API_KEY="test_xxx"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
